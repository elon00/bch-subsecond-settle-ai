{
  "mcpServers": {
    "bch-subsecond-settle-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Bitcoin Cash",
        "PROJECT_TICKER": "BCHFAST"
      },
      "tools": [
        {
          "name": "verify_bchfast_invariants",
          "description": "Verifies deterministic invariants for BCH Sub-Second Settle AI on Bitcoin Cash."
        },
        {
          "name": "execute_bchfast_action",
          "description": "Executes authenticated Payments state transition."
        }
      ]
    }
  }
}